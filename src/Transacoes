package application;

import java.sql.Connection;
import java.sql.SQLException;
import java.sql.Statement;

import db.DB;

public class Program {

	public static void main(String[] args) {
		Connection conn = DB.conectaDB();
		Statement st = null;
		
		
		try {
			st = conn.createStatement();
-->			conn.setAutoCommit(false); // inicia a operação
			
			int rows1 = st.executeUpdate("UPDATE seller SET BaseSalary = 2090 WHERE DepartmentId = 1");
			
			int x = 1;
			if (x < 2) {
				throw new SQLException("Fake error");
			}
			
			
			int rows2 = st.executeUpdate("UPDATE seller SET BaseSalary = 3090 WHERE DepartmentId = 2");
			
-->			conn.commit(); //efetiva a operação
			
			System.out.println("Rows1 " + rows1);
			System.out.println("Rows2 " + rows2);
			
			
		} catch (SQLException e) {
			try {
-->				conn.rollback(); // cancela a operação em caso de erro
				throw new SQLException("Transaction rolled back: " + e.getMessage());
				
			} catch (SQLException e1) {
				
				e1.printStackTrace();
			}
		} finally {
			try {
				st.close();
				conn.close();
			} catch (SQLException e) {
				e.printStackTrace();
			}
			
		}
	}

}
